{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=captiongen;Username=app;Password=app"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutSeconds": 30,
    "HealthPath": "health"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "Enabled": false,
    "DemoEmail": "demo@captiongen.local",
    "DemoPassword": "Passw0rd!"
  },
  "MediaStorage": {
    "Provider": "Local",
    "RootPath": "media",
    "PublicBaseUrl": "http://localhost:5000/media",
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "captiongen-media",
      "PublicBaseUrl": "",
      "CreateContainerIfNotExists": true
    }
  },
  "ContentPolicy": {
    "Platforms": [ "instagram", "tiktok", "linkedin" ],
    "Tones": [ "funny", "professional", "inspirational" ],
    "Goals": [ "engagement", "sales", "awareness" ],
    "CaptionLengths": [ "short", "medium", "long" ],
    "MinCaptionCount": 1,
    "MaxCaptionCount": 10,
    "MinHashtags": 5,
    "MaxHashtags": 20
  },
  "Scheduling": {
    "LocalTimezone": "Europe/Bucharest"
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "SuccessUrl": "http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:5173/checkout/cancel",
    "WebhookSecret": "",
    "PriceIds": {
      "basic": "",
      "freelancer": "",
      "influencer": "",
      "agency": ""
    }
  },
  "Jwt": {
    "Issuer": "CaptionGen",
    "Audience": "CaptionGen",
    "Key": "CHANGE_ME_32CHARS_MINIMUM_CHANGE_ME_NOW",
    "AccessMinutes": "60",
    "CookieName": "cg_at",
    "AllowInsecureCookieOnHttp": true
  }
}
